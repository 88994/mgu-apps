[Unit]
Description=MGU Video Hub private Wi-Fi firewall helper
After=oapcontroller.service
RequiresMountsFor=/var/opt
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/var/opt/mgu-video-net/current/mgu-video-net
ExecStopPost=-/usr/bin/node /var/opt/mgu-video-net/current/firewall.js close
User=root
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
