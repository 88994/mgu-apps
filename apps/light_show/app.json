          "Save diagnostic log"
        ],
        [
          "scroll",
          "DIAG_TEXT",
          "Loading diagnostics..."
        ]
      ]
    },
    {
      "name": "CONFIRM_LIGHTS",
      "kind": "menu",
      "title": "Check normal lighting first",
      "items": [
        [
          "text3",
          "RESET_NOTICE",
          "First check normal headlights and indicators with the vehicle switches. Continue only if normal operation is restored. This clears saved app state; it does not prove the IO release succeeded."
        ],
        [
          "button",
          "BTN_CONFIRM_CLEAR",
          "I checked normal lights - clear saved lock"
        ],
        [
          "button",
          "BTN_CANCEL_CLEAR",
          "Cancel"
        ]
      ]
    }
