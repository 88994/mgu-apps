{
  "id": "custom_cluster",
  "title": "Custom Cluster",
  "description": "G80-style full cluster preview and guarded panel, shared Waze renderer and iPhone status bridge",
  "version": "0.2.0",
  "vendor": "custom",
  "loggingId": "OAQ7",
  "iconGlyph": "CC",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Custom Cluster",
      "buttons": [["BTN_TEST", "Parked panel test"], ["BTN_SETTINGS", "Settings"]]
    }
  ],
  "settings": [
    {"key": "layout", "label": "Cluster layout", "type": "choice", "default": "stock",
     "options": [["stock", "BMW stock (Waze remains)"], ["g80", "G80 full cluster (parked test)"],
                 ["sport", "M Sport"],
                 ["classic", "Classic dials"], ["minimal", "Minimal digital"]]},
    {"key": "wazeMap", "label": "Waze map in cluster", "type": "choice", "default": "auto",
     "options": [["auto", "Keep Waze's own setting"], ["on", "Show Waze map"],
                 ["off", "Hide Waze map"]]},
    {"key": "accent", "label": "Instrument colour", "type": "choice", "default": "m",
     "options": [["m", "M blue"], ["red", "M red"], ["ice", "Ice white"], ["amber", "Amber"]]},
    {"key": "phoneBridge", "label": "iPhone Shortcuts bridge", "type": "bool", "default": false},
    {"key": "phoneBadge", "label": "Phone status badge (map/panel)", "type": "bool", "default": false},
    {"key": "demo", "label": "Preview data (HMI only)", "type": "choice", "default": "off",
     "options": [["off", "Live values only"], ["on", "Preview on centre display"]]}
  ]
}
