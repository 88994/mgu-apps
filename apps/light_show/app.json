      "title": "Light Show - screen preview",
      "buttons": [
        [
          "BTN_BACK",
          "Menu"
        ],
        [
          "BTN_PREVIEW_STOP",
          "Stop preview"
        ]
      ]
    },
    {
      "name": "DIAGNOSTICS",
      "kind": "menu",
      "title": "Light Show - diagnostics",
      "items": [
        [
          "button",
          "BTN_DIAG_STOP",
          "STOP / return lights to vehicle"
        ],
        [
          "button",
          "BTN_DIAG_IDENTIFY",
          "Check BDC connection"
        ],
        [
          "button",
