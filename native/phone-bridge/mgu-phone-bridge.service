[Unit]
Description=MGU Phone Terminal Bridge
After=oapcontroller.service
RequiresMountsFor=/var/opt
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/var/opt/mgu-phone-bridge/current/mgu-phone-bridge
ExecStopPost=-/usr/bin/node /var/opt/mgu-phone-bridge/current/firewall.js close
User=root
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
