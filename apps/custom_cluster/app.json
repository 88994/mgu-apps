{
  "id": "custom_cluster",
  "title": "Custom Cluster",
  "description": "G80 and OEM-inspired full-cluster colour studio, map-safe overlays, shared Waze renderer and iPhone status bridge",
  "version": "0.4.0",
  "vendor": "custom",
  "loggingId": "OAQ7",
  "iconGlyph": "CC",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Custom Cluster",
      "buttons": [["BTN_TEST", "Parked panel test"], ["BTN_SETTINGS", "Settings"]]
    }
  ],
  "settings": [
    {"key": "layout", "label": "Cluster layout", "type": "choice", "default": "stock",
     "options": [["stock", "BMW original (unchanged)"], ["oem", "G21 OEM-style recolor (parked test)"],
                 ["g80", "G80 full cluster (parked test)"],
                 ["sport", "M Sport"],
                 ["classic", "Classic dials"], ["minimal", "Minimal digital"]]},
    {"key": "wazeMap", "label": "Waze map in cluster", "type": "choice", "default": "auto",
     "options": [["auto", "Keep Waze's own setting"], ["on", "Show Waze map"],
                 ["off", "Hide Waze map"]]},
    {"key": "colorMode", "label": "Color source", "group": "Cluster colors", "type": "choice", "default": "palette",
     "options": [["palette", "Color palette"], ["rgb", "Custom RGB"], ["cycle", "Automatic color cycle"]]},
    {"key": "accent", "label": "Instrument accent", "group": "Cluster colors", "type": "choice", "default": "m", "when": {"colorMode": "palette"},
     "options": [["m", "M blue"], ["cyan", "Turquoise"], ["green", "Neon green"],
                 ["purple", "Purple"], ["pink", "Pink"], ["red", "M red"],
                 ["orange", "Fire orange"], ["amber", "Amber"],
                 ["ice", "Ice white"], ["white", "Pure white"]]},
    {"key": "rgbRed", "label": "Custom red", "group": "Cluster colors", "type": "number", "default": 32,
     "steps": [0,16,32,48,64,80,96,112,128,144,160,176,192,208,224,240,255], "when": {"colorMode": "rgb"}},
    {"key": "rgbGreen", "label": "Custom green", "group": "Cluster colors", "type": "number", "default": 176,
     "steps": [0,16,32,48,64,80,96,112,128,144,160,176,192,208,224,240,255], "when": {"colorMode": "rgb"}},
    {"key": "rgbBlue", "label": "Custom blue", "group": "Cluster colors", "type": "number", "default": 255,
     "steps": [0,16,32,48,64,80,96,112,128,144,160,176,192,208,224,240,255], "when": {"colorMode": "rgb"}},
    {"key": "cycleSeconds", "label": "Full rainbow cycle", "group": "Cluster colors", "type": "number", "unit": "s", "default": 20,
     "steps": [5,10,15,20,30,60,120], "when": {"colorMode": "cycle"}},
    {"key": "colorBrightness", "label": "Color brightness", "group": "Cluster colors", "type": "number", "unit": "%", "default": 100,
     "steps": [25,40,55,70,85,100]},
    {"key": "phoneBridge", "label": "iPhone Shortcuts bridge", "type": "bool", "default": false},
    {"key": "phoneBadge", "label": "Phone status badge (map/panel)", "type": "bool", "default": false},
    {"key": "demo", "label": "Preview data (HMI only)", "type": "choice", "default": "off",
     "options": [["off", "Live values only"], ["on", "Preview on centre display"]]}
  ]
}
