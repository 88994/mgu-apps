{
  "id": "light_show",
  "title": "Light Show",
  "description": "Native iDrive 7 strobe menu for BDC_G05. Six patterns, selectable front light pair, tempo and duration, separate screen preview and explicit OEM release. Experimental: physical lamp operation has not yet been tested on this vehicle.",
  "version": "0.1.1",
  "vendor": "custom",
  "loggingId": "OAL9",
  "iconGlyph": "LS",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "Light Show",
      "settings": true,
      "items": [
        [
          "text",
